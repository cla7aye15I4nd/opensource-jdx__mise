#!/usr/bin/env bash

# A conda dependency recorded again with no checksum from its channel is
# checked against the pin mise.lock has for it, by downloading the archive.
# That download is the work of the tool that needs the package: in safe mode,
# a tool from project config sends no netrc login with it, even to a host no
# project option names (here the channel comes from the operator's setting).

export MISE_LOCKFILE=1
# The recheck is part of generating the lockfile; the harness defaults to merge.
export MISE_LOCKFILE_MODE=generate

CHANNEL_ROOT="$PWD/channel"
mkdir -p "$CHANNEL_ROOT/chan/noarch"
python3 - "$CHANNEL_ROOT/chan/noarch" <<'PY'
import hashlib
import io
import json
import sys
import tarfile
from pathlib import Path

subdir = Path(sys.argv[1])


def package(name, version, depends, files):
    index = {
        "name": name,
        "version": version,
        "build": "0",
        "build_number": 0,
        "depends": depends,
        "subdir": "noarch",
    }
    paths = [{
        "_path": path,
        "path_type": "hardlink",
        "sha256": hashlib.sha256(content).hexdigest(),
        "size_in_bytes": len(content),
    } for path, content in files.items()]
    metadata = {
        "info/index.json": json.dumps(index).encode(),
        "info/paths.json": json.dumps({"paths_version": 1, "paths": paths}).encode(),
        "info/files": ("\n".join(files) + "\n").encode(),
    }
    archive_name = f"{name}-{version}-0.tar.bz2"
    with tarfile.open(subdir / archive_name, "w:bz2") as archive:
        for path, content in {**files, **metadata}.items():
            info = tarfile.TarInfo(path)
            info.size = len(content)
            info.mode = 0o755 if path.startswith("bin/") else 0o644
            archive.addfile(info, io.BytesIO(content))
    data = (subdir / archive_name).read_bytes()
    return archive_name, index, hashlib.sha256(data).hexdigest(), len(data)


packages = {}
# The channel publishes no checksum for the dependency.
name, index, sha256, size = package(
    "pinrecheck-dep", "1.0.0", [], {"share/pinrecheck-dep.txt": b"dep\n"}
)
packages[name] = {**index, "size": size}
(subdir.parent.parent / "dep.sha256").write_text(sha256)
for version in ["1.0.0", "1.0.1"]:
    name, index, sha256, size = package(
        "pinrecheck",
        version,
        ["pinrecheck-dep"],
        {"bin/pinrecheck": b"#!/bin/sh\necho ok\n"},
    )
    packages[name] = {**index, "sha256": sha256, "size": size}
(subdir / "repodata.json").write_text(json.dumps({
    "info": {"subdir": "noarch"},
    "packages": packages,
    "packages.conda": {},
    "removed": [],
    "repodata_version": 1,
}))
PY
DEP_SHA="$(cat "$CHANNEL_ROOT/dep.sha256")"
start_http_server --dir "$CHANNEL_ROOT" --headers-log "$PWD/logs"
export MISE_CONDA_CHANNEL="http://127.0.0.1:$HTTP_PORT/chan"

cat <<EOF >mise.toml
[tools]
"conda:pinrecheck" = "1.0.0"
EOF
touch mise.lock
mise lock --platform linux-x64
assert_contains "cat mise.lock" "pinrecheck-dep-1.0.0-0"

# The channel gives no checksum for the dependency, so mise lock pins the
# archive it downloaded.
assert_contains "cat mise.lock" "sha256:$DEP_SHA"

printf 'machine 127.0.0.1\nlogin netrc-user\npassword netrc-secret\n' >"$HOME/.netrc"
chmod 600 "$HOME/.netrc"
basic="$(printf 'netrc-user:netrc-secret' | base64)"

# The tool moves to 1.0.1 with the same dependency, which the channel still
# gives no checksum for: the archive is downloaded and checked against the pin.
cat <<EOF >mise.toml
[tools]
"conda:pinrecheck" = "1.0.1"
EOF
rm -rf logs
mise cache clear >/dev/null 2>&1
assert_succeed "MISE_SAFE=1 mise lock --platform linux-x64"
assert_contains "cat mise.lock" "sha256:$DEP_SHA"
assert_succeed "grep -rqs 'pinrecheck-dep-1.0.0-0.tar.bz2' logs"
assert_fail "grep -rqs -- '$basic' logs"

# An md5 pin, as a channel that published only md5 left it: the sha256 mise
# lock computes now that the channel gives none does not replace it unchecked.
DEP_ARCHIVE="$CHANNEL_ROOT/chan/noarch/pinrecheck-dep-1.0.0-0.tar.bz2"
set_dep_pin() {
  python3 - mise.lock "$1" <<'PY'
import re
import sys
from pathlib import Path

path, pin = Path(sys.argv[1]), sys.argv[2]
text = path.read_text()
pattern = r'(\[conda-packages\.linux-x64\."pinrecheck-dep-1\.0\.0-0@[0-9a-f]+"\]\nurl = "[^"]*"\nchecksum = )"[^"]*"'
text, count = re.subn(pattern, rf'\1"{pin}"', text)
assert count == 1, text
path.write_text(text)
PY
}
cat <<EOF >mise.toml
[tools]
"conda:pinrecheck" = "1.0.0"
EOF
set_dep_pin "md5:$(python3 -c 'import hashlib; print(hashlib.md5(b"other bytes").hexdigest())')"
assert_fail "mise lock --platform linux-x64" "does not match the checksum mise.lock pinned it by"
set_dep_pin "md5:$(python3 -c 'import hashlib, sys; print(hashlib.md5(open(sys.argv[1], "rb").read()).hexdigest())' "$DEP_ARCHIVE")"
assert_succeed "mise lock --platform linux-x64"
assert_contains "cat mise.lock" "sha256:$DEP_SHA"
assert_not_contains "cat mise.lock" "md5:"
